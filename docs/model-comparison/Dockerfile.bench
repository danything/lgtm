FROM mc-bench AS b
RUN cd /t && echo '{"name":"b","trustedDependencies":["openvino-node","onnxruntime-node","@tensorflow/tfjs-node"]}' > package.json \
 && bun add onnxruntime-node@1.31.1 onnxruntime-web@1.31.1 @huggingface/transformers@4.3.2 openvino-node@2026.4.1 @tensorflow/tfjs-node@4.22.0 \
 && mkdir /lib-extra && cp -L /usr/lib/x86_64-linux-gnu/libstdc++.so.6 /usr/lib/x86_64-linux-gnu/libgcc_s.so.1 /lib-extra/ \
 && du -sh node_modules/* | sort -h | tail -12
FROM oven/bun:1.4.5-distroless
COPY --from=b /t /t
COPY --from=b /hfjs /hfjs
COPY --from=b /lib-extra/ /usr/lib/x86_64-linux-gnu/
COPY bench.ts tfjs.ts worker.ts worker-main.ts /t/
WORKDIR /t
ENV ORT_DISABLE_TELEMETRY=1
ENTRYPOINT ["/usr/local/bin/bun"]
