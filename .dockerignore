# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# sveltekit
/.svelte-kit/
/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# typescript
*.tsbuildinfo

/compose.yml
/images/*
/data/

# Built by the Dockerfile's wasm stage. A local copy from scripts/build-wasm.sh
# would only be overwritten, and would bust the cache when rebuilt.
/src/lib/lgtm/vendor/lgtm-wasm.js
/src/lib/lgtm/vendor/lgtm-wasm.wasm

# Nothing below is copied into the image; excluding it keeps a docs or manifest
# edit from busting the build cache.
/deploy
/.github
/.claude
/.vscode
/README.md
/LICENSE
/renovate.json
/s.sh
/compose.override.yml
# The wasm check runs against a built image, from outside it.
/tests
/test-results
/playwright-report
